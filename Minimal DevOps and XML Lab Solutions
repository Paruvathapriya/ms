[QUESTION]
Deploy frontend, patient-service backend with 3 replicas, readiness/liveness probes, and HPA (3 to 6 replicas).

[FILE: hospital.yaml]
```yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: patient-backend
spec:
  replicas: 3
  selector:
    matchLabels:
      app: patient-backend
  template:
    metadata:
      labels:
        app: patient-backend
    spec:
      containers:
        - name: backend
          image: nginx:alpine
          resources:
            requests:
              cpu: 50m
          livenessProbe:
            httpGet:
              path: /
              port: 80
          readinessProbe:
            httpGet:
              path: /
              port: 80
---
apiVersion: v1
kind: Service
metadata:
  name: patient-backend-svc
spec:
  selector:
    app: patient-backend
  ports:
    - port: 80
---
apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: backend-hpa
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: patient-backend
  minReplicas: 3
  maxReplicas: 6
  metrics:
    - type: Resource
      resource:
        name: cpu
        target:
          type: Utilization
          averageUtilization: 50
```

[RUN COMMANDS]
kubectl apply -f hospital.yaml
kubectl get hpa backend-hpa


